  ],
  ".card": [
   "background:var(--paper);border:1pxsolidvar(--rule);border-radius:16px;padding:1.1rem1.15rem;margin-top:1.1rem"
  ],
  ".field input:focus": [
   "outline:none;border-color:var(--terra);background:#fff"
  ],
  ".result .eyebrow": [
   "color:var(--ochre)"
  ],
  ".chart-card": [
   "background:var(--paper);border:1pxsolidvar(--rule);border-radius:16px;padding:1.05rem1.1rem1.2rem;margin-top:1.1rem"
  ],
  ".chart-card h4": [
