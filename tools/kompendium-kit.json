{
 "_hinweis": "Die wortgleich auf mindestens sechs der neun Kompendienseiten kopierten CSS-Regeln, die hb-kompendium.css zentral uebernommen hat. Eingefroren vor Remake v3 Welle 19 — nach dem Umbau gibt es die Kopien nicht mehr zu zaehlen.",
 "basis": "b4fb65e0f86914a44f4f0278135f7f391d30b92f",
 "seiten": [
  "auto.html",
  "digital.html",
  "erstehilfe.html",
  "finanzen.html",
  "haushalt.html",
  "lebensmittel.html",
  "papierkram.html",
  "pflanzen.html",
  "wissen.html"
 ],
 "kit": {
  ":root": [
   "--bg:#f3eee5;--bg2:#ebe3d4;--paper:#fffdf8;--ink:#1f1c17;--ink2:#524a3e;--rule:#d8cdb7;--terra:#b04a31;--ochre:#a97a1d;--moss:#4a5c39;--burg:#792d29;--aub:#6b3951;--good:#6f8f4e"
  ],
  "*": [
   "box-sizing:border-box;margin:0;padding:0"
  ],
  "body": [
   "background:var(--bg);color:var(--ink);font-family:'Manrope',system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased"
  ],
  ".wrap": [
   "max-width:900px;margin:0auto;padding:1.8rem1.1rem5rem"
  ],
  ".eyebrow": [
   "font-family:'JetBrainsMono',monospace;font-size:.66rem;letter-spacing:.32em;text-transform:uppercase;color:var(--terra)"
  ],
  ".leaf": [
   "display:inline-block;vertical-align:-6px;margin-right:.2rem"
  ],
  "h1": [
   "font-family:'Fraunces',serif;font-weight:400;font-size:clamp(2rem,6.5vw,3.1rem);line-height:1.02;letter-spacing:-.02em;margin:.3rem0.5rem"
  ],
  "h1 em": [
   "font-style:italic;color:var(--terra)"
  ],
  ".lead": [
   "color:var(--ink2);max-width:64ch;font-size:1.02rem"
  ],
  ".controls": [
   "position:sticky;top:0;background:rgba(243,238,229,.94);backdrop-filter:blur(6px);z-index:5;padding:.9rem0.7rem;margin-top:1.3rem;border-bottom:1pxsolidvar(--rule)"
  ],
  ".row": [
   "display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin-bottom:.5rem"
  ],
  ".row .lbl": [
   "font-family:'JetBrainsMono',monospace;font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ochre);width:100%;margin-bottom:.1rem"
  ],
  ".chip": [
   "border:1pxsolidvar(--rule);background:var(--paper);border-radius:999px;padding:.34rem.8rem;font:inherit;font-size:.82rem;font-weight:600;cursor:pointer;color:var(--ink)"
  ],
  ".chip.on": [
   "background:var(--ink);color:var(--bg);border-color:var(--ink)"
  ],
  ".chip:focus-visible,#q:focus-visible": [
   "outline:2pxsolidvar(--ochre);outline-offset:2px"
  ],
  "#q": [
   "flex:1;min-width:160px;border:1pxsolidvar(--rule);background:var(--paper);border-radius:11px;padding:.5rem.8rem;font:inherit"
  ],
  ".count": [
   "font-family:'JetBrainsMono',monospace;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin:.9rem0.5rem"
  ],
  "#detail": [
   "margin:.4rem01.2rem"
  ],
  ".dcard": [
   "background:var(--paper);border:1pxsolidvar(--rule);border-radius:18px;padding:1.3rem1.35rem"
  ],
  ".dhead": [
   "display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap"
  ],
  ".dhead h2": [
   "font-family:'Fraunces',serif;font-weight:500;font-size:1.7rem;line-height:1.1"
  ],
  ".dhead .sub": [
   "color:var(--ink2);font-size:.92rem"
  ],
  ".close": [
   "border:0;background:var(--bg2);border-radius:9px;padding:.35rem.7rem;font:inherit;font-weight:700;cursor:pointer;color:var(--ink2)"
  ],
  ".close:focus-visible": [
   "outline:2pxsolidvar(--ochre);outline-offset:2px"
  ],
  ".badges": [
   "display:flex;flex-wrap:wrap;gap:.4rem;margin:.6rem0.2rem"
  ],
  ".b": [
   "font-family:'JetBrainsMono',monospace;font-size:.56rem;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:.24rem.6rem"
  ],
  ".b.kat": [
   "background:var(--bg2);color:var(--ink2)"
  ],
  ".sec": [
   "font-family:'JetBrainsMono',monospace;font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ochre);margin-top:1.05rem;padding-top:.65rem;border-top:1pxsolidvar(--rule)"
  ],
  ".stext": [
   "font-size:.95rem;margin-top:.3rem"
  ],
  ".box .bt": [
   "font-family:'JetBrainsMono',monospace;font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;display:block;margin-bottom:.2rem"
  ],
  ".tip": [
   "border:1pxdashedvar(--ochre);border-radius:12px;padding:.7rem.9rem;margin-top:.7rem;font-size:.95rem;font-weight:600"
  ],
  ".tip .bt": [
   "font-family:'JetBrainsMono',monospace;font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;display:block;margin-bottom:.2rem;color:var(--terra);font-weight:600"
  ],
  ".pc": [
   "text-align:left;background:var(--paper);border:1pxsolidvar(--rule);border-radius:14px;padding:.85rem.95rem;cursor:pointer;font:inherit;color:var(--ink);transition:.12s"
  ],
  ".pc:hover": [
   "border-color:var(--terra);transform:translateY(-1px)"
  ],
  ".pc:focus-visible": [
   "outline:2pxsolidvar(--ochre);outline-offset:2px"
  ],
  ".pc .n": [
   "font-family:'Fraunces',serif;font-size:1.08rem;line-height:1.18"
  ],
  ".pc .meta": [
   "display:flex;flex-wrap:wrap;gap:.15rem.35rem;margin-top:.5rem;font-family:'JetBrainsMono',monospace;font-size:.6rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)"
  ],
  ".empty": [
   "display:none;background:var(--paper);border:1pxdashedvar(--rule);border-radius:14px;padding:1.2rem;text-align:center;color:var(--ink2)"
  ],
  ".foot": [
   "font-family:'JetBrainsMono',monospace;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);text-align:center;margin-top:2.4rem"
  ],
  ".foot a": [
   "color:var(--aub)"
  ]
 }
}