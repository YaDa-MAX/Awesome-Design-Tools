   "width:min(540px,84vw);height:auto;display:block"
  ],
  "*": [
   "box-sizing:border-box"
  ],
  "body": [
   "margin:0;background:var(--bg);color:var(--ink);font-family:'Manrope',-apple-system,SegoeUI,sans-serif;line-height:1.5",
   "margin:0;background:var(--bg);color:var(--ink);font-family:'Manrope',-apple-system,SegoeUI,sans-serif;line-height:1.55"
  ],
  ".wrap": [
   "max-width:1040px;margin:0auto;padding:01.5rem"
  ],
